# Frodo Environment Configuration

# App
APP_NAME=frodo
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database (legacy Python async URL shown below)
# Node monorepo (api/worker/Drizzle): use postgresql:// or postgres:// — see docs/v2/ENVIRONMENT.md
DATABASE_URL=postgresql+asyncpg://frodo:frodo@localhost:5432/frodo
# Optional: direct URI for Drizzle migrations when DATABASE_URL points at a pooler (e.g. Supabase)
# DATABASE_MIGRATION_URL=postgresql://postgres:...@db.<project-ref>.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Token Vault Encryption
TOKEN_VAULT_KEY=change-me-base64-encoded-32-byte-key

# TikTok Shop App
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# TikTok Developer App
TIKTOK_DEVELOPER_CLIENT_KEY=
TIKTOK_DEVELOPER_CLIENT_SECRET=

# TikTok Marketing App
TIKTOK_MARKETING_APP_ID=
TIKTOK_MARKETING_APP_SECRET=

# TikTok Research API (requires approval from TikTok)
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

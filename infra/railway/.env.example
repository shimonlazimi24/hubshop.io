# Reference: paste into Railway → each service → Variables (do not commit real .env with secrets).
# Service names below match Railway; use "Variable Reference" in the UI for Postgres, or CLI with
# single quotes: railway variables --service '@frodo/api' --set 'DATABASE_URL=${{Postgres.DATABASE_URL}}'
#
# Full semantics: docs/v2/ENVIRONMENT.md and docs/v2/RAILWAY_DEPLOYMENT.md

# =============================================================================
# @frodo/api
# =============================================================================
APP_ENV=staging
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=change-me-min-16-chars-rotate-in-railway
# Apply Drizzle migrations on each API boot (Postgres advisory lock). Recommended on Railway with Postgres plugin.
RUN_DB_MIGRATIONS_ON_STARTUP=true
# Optional: direct URL for DDL if pooler blocks migrations (else same as DATABASE_URL)
# DATABASE_MIGRATION_URL=postgresql://...
TOKEN_ENCRYPTION_KEY=change-me-32-byte-secret-for-token-vault
PUBLIC_WEB_ORIGIN=https://your-web-host.example
INTERNAL_CRON_SECRET=change-me-min-8-chars-same-as-scheduler-or-cron-job

# -----------------------------------------------------------------------------
# AWS SQS — API + worker share ONE Standard queue URL (ADR-001). Add DLQ + IAM in AWS.
# SDK picks up AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN automatically.
#
# API IAM (least privilege): sqs:SendMessage on the queue ARN (+ sqs:GetQueueAttributes if tooling needs it).
# Worker IAM: sqs:ReceiveMessage, sqs:DeleteMessage, sqs:ChangeMessageVisibility, sqs:GetQueueAttributes.
# Full policy example: docs/v2/RAILWAY_DEPLOYMENT.md §9
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — temporary creds (STS assume-role); omit for long-lived IAM user keys
# AWS_SESSION_TOKEN=
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/your-primary-queue

REDIS_URL=${{Redis.REDIS_URL}}
REQUIRE_REDIS_FOR_AUTH=true

# TikTok Shop (required for APP_ENV staging/production per app-env validation)
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Numeric / opaque ID from Partner Center after app creation — NOT a placeholder (TikTok returns "This service does not exist" if wrong).
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_REDIRECT_URI=https://your-api-host.example/api/connect/shop/callback

# Never on Railway production:
# ALLOW_ASYNC_SKIP=true

# =============================================================================
# @frodo/worker
# =============================================================================
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# APP_ENV=staging
# NODE_ENV=production
#
# --- Same SQS queue + region as @frodo/api (copy values or duplicate Variables in Railway UI) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/your-primary-queue
#
# --- Optional worker tuning (defaults: visibility 300s, extension 0) ---
# SQS_VISIBILITY_TIMEOUT_SECONDS=300
# SQS_VISIBILITY_EXTENSION_SECONDS=0
#
# REDIS_URL=${{Redis.REDIS_URL}}
# TOKEN_ENCRYPTION_KEY=<same as API>
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=

# Bootstrap only (development + no SQS). Remove when real queue is wired:
# APP_ENV=development
# WORKER_SQS_DISABLED=true

# =============================================================================
# @frodo/scheduler (optional; prefer Railway Cron → POST /api/internal/cron/tick)
# =============================================================================
# CRON_BASE_URL=https://your-api-host.example
# INTERNAL_CRON_SECRET=<same as API INTERNAL_CRON_SECRET>
# Optional: ms between tick POSTs (default 60000, minimum 10000)
# CRON_TICK_INTERVAL_MS=60000

# =============================================================================
# @frodo/web
# =============================================================================
# Set at build time (and runtime for vite preview proxy). Must be your API public origin.
# VITE_API_URL=https://your-api-host.example
# Optional override for preview proxy only:
# VITE_API_PROXY=https://your-api-host.example

# Reference: paste into Railway → each service → Variables (do not commit real .env with secrets).
# Service names below match Railway; use "Variable Reference" in the UI for Postgres, or CLI with
# single quotes: railway variables --service '@frodo/api' --set 'DATABASE_URL=${{Postgres.DATABASE_URL}}'
#
# Full semantics: docs/v2/ENVIRONMENT.md and docs/v2/RAILWAY_DEPLOYMENT.md

# =============================================================================
# @frodo/api
# =============================================================================
APP_ENV=staging
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=change-me-min-16-chars-rotate-in-railway
TOKEN_ENCRYPTION_KEY=change-me-32-byte-secret-for-token-vault
PUBLIC_WEB_ORIGIN=https://your-web-host.example
INTERNAL_CRON_SECRET=change-me-min-8-chars-same-as-scheduler-or-cron-job

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/your-queue

REDIS_URL=${{Redis.REDIS_URL}}
REQUIRE_REDIS_FOR_AUTH=true

# TikTok Shop (required for APP_ENV staging/production per app-env validation)
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_REDIRECT_URI=https://your-api-host.example/api/connect/shop/callback

# Never on Railway production:
# ALLOW_ASYNC_SKIP=true

# =============================================================================
# @frodo/worker
# =============================================================================
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# APP_ENV=staging
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SQS_QUEUE_URL=<same as API>
# REDIS_URL=${{Redis.REDIS_URL}}
# TOKEN_ENCRYPTION_KEY=<same as API>
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=

# Bootstrap only (development + no SQS). Remove when real queue is wired:
# APP_ENV=development
# WORKER_SQS_DISABLED=true

# =============================================================================
# @frodo/scheduler (optional; prefer Railway Cron → POST /api/internal/cron/tick)
# =============================================================================
# CRON_BASE_URL=https://your-api-host.example
# INTERNAL_CRON_SECRET=<same as API INTERNAL_CRON_SECRET>

# =============================================================================
# @frodo/web
# =============================================================================
# VITE_API_URL=https://your-api-host.example

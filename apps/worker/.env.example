# Copy to apps/worker/.env (gitignored). Worker loads env from process when using pnpm --filter @frodo/worker.
#
# Same SQS contract as apps/api — primary Standard queue URL must match the API’s SQS_QUEUE_URL.
# See docs/v2/ENVIRONMENT.md § AWS SQS, docs/v2/RAILWAY_DEPLOYMENT.md §9, infra/railway/.env.example

APP_ENV=development
NODE_ENV=development

DATABASE_URL=postgresql://frodo:frodo@127.0.0.1:5432/frodo

# --- AWS SQS (required for staging/production; pair with API) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/your-primary-queue

# --- Optional ReceiveMessage tuning (defaults: 300 / 0) ---
# SQS_VISIBILITY_TIMEOUT_SECONDS=300
# SQS_VISIBILITY_EXTENSION_SECONDS=0

# Local dev only — worker stays up without polling SQS (do not use on Railway):
# WORKER_SQS_DISABLED=true

# Redis optional locally; TOKEN_ENCRYPTION_KEY + TikTok vars needed for shop discovery jobs
# REDIS_URL=redis://127.0.0.1:6379/0
# TOKEN_ENCRYPTION_KEY=
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=

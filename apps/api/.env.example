# Copy to apps/api/.env and adjust. Nest loads .env from apps/api when using pnpm --filter @frodo/api.
#
# Architecture: ADR-001 — async jobs = AWS SQS + apps/worker (same SQS_QUEUE_URL). Redis ≠ job broker.
# See docs/v2/ADR-001-frodo-v2-stack.md and docs/v2/ENVIRONMENT.md § AWS SQS.
#
# --- Migrating from legacy Python Frodo `env` / `env.handoff` ---
# Do not commit real secrets. Keep `.env` gitignored.
#
# | Legacy (old backend)        | v2 API (`apps/api/.env`)     | Notes |
# |-----------------------------|------------------------------|--------|
# | DATABASE_URL (asyncpg)      | DATABASE_URL                 | Remove `+asyncpg` → `postgresql://...` (same host/db/user). |
# | JWT_SECRET_KEY              | JWT_SECRET                   | Same secret; v2 requires min 16 characters. |
# | TOKEN_VAULT_KEY             | TOKEN_ENCRYPTION_KEY         | Must match tokens already encrypted in DB; never rotate without a re-encrypt plan. |
# | TIKTOK_SHOP_APP_KEY/SECRET  | TIKTOK_SHOP_APP_KEY/SECRET   | Same values. Add TIKTOK_SHOP_SERVICE_ID + TIKTOK_SHOP_REDIRECT_URI per Partner Center. |
# | FRONTEND_URL (e.g. :3000)   | PUBLIC_WEB_ORIGIN            | Vite default: `http://localhost:5173`. |
# | REDIS_URL                   | REDIS_URL                    | Optional in local dev; required in staging/prod for auth blacklist. |
# | CELERY_* / sidecar vars     | —                            | v2 uses SQS + worker; see docs/v2/ENVIRONMENT.md. No Celery. |
# | SECRET_KEY / DEBUG / APP_*  | —                            | Not used by Nest v2 the same way; see `packages/config` for `APP_ENV`, `NODE_ENV`. |

APP_ENV=development
NODE_ENV=development

# PostgreSQL (Node / Drizzle) — use postgresql:// NOT postgresql+asyncpg://
DATABASE_URL=postgresql://frodo:frodo@127.0.0.1:5432/frodo

JWT_SECRET=change-me-min-16-chars-local

# CORS: must match Vite dev origin
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Local dev: API starts without SQS; Shop Connect enqueue still needs real SQS unless you mock
ALLOW_ASYNC_SKIP=true

# Optional locally — logout blacklist disabled without Redis when APP_ENV=development
# REDIS_URL=redis://127.0.0.1:6379/0

# TikTok Shop (optional until you test OAuth)
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_SERVICE_ID=
# TIKTOK_SHOP_REDIRECT_URI=http://localhost:8001/api/connect/shop/callback
# TOKEN_ENCRYPTION_KEY=

# AWS (required for worker + for Shop enqueue when ALLOW_ASYNC_SKIP is false)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SQS_QUEUE_URL=

# Cron tick (optional)
# INTERNAL_CRON_SECRET=

# Webhooks: POST /api/webhooks/shop verifies TikTok-Signature (HMAC) using TIKTOK_SHOP_APP_SECRET.
# Optional replay skew (seconds), default 300:
# TIKTOK_WEBHOOK_MAX_SKEW_SECONDS=300
# Development only — never in staging/production:
# ALLOW_UNVERIFIED_WEBHOOKS=false

# --- Railway (hosted) ---
# Copy keys you need into Railway → @frodo/api → Variables. Prefer UI "Variable Reference" for
# DATABASE_URL → Postgres plugin, REDIS_URL → Redis plugin. See infra/railway/.env.example for a
# full per-service checklist (API, worker, scheduler, web).
# PORT is injected by Railway; do not set manually unless you know why.
